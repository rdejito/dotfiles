# ===============================
# Ghostty - Japanese Cyberpunk
# ===============================

# Font
font-family = FiraCode Nerd Font
font-size = 12

# Cursor
cursor-style = block
cursor-style-blink = true

# Window
window-padding-x = 12
window-padding-y = 10
window-decoration = false
window-theme = dark

# Background
background-opacity = 0.75
background = 0a0a12

# Foreground
foreground = e6e6ff

# Selection
selection-background = 1a1a2e
selection-foreground = 00f5ff

# Scrollback
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true

# Shell
shell-integration = zsh

confirm-close-surface = false
